# GEMINI_API_KEY: Required for server-side Gemini AI recommendation copy.
# Keep this secret on the server or serverless proxy; never expose in browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: Optional server-side TMDB v3 API key (preferred when running server.ts or a serverless proxy).
TMDB_API_KEY=""

# VITE_TMDB_API_KEY: Optional read-only TMDB v3 API key for static GitHub Pages builds without a backend proxy.
VITE_TMDB_API_KEY=""

# VITE_API_BASE_URL: Optional external serverless proxy base URL (e.g., https://denetflix-api.yourname.workers.dev)
# Leave empty when using the included Express server.
VITE_API_BASE_URL=""

# VITE_DEFAULT_COUNTRY: Two-letter ISO 3166-1 country code for streaming availability checks (e.g., US, GB, CA, AU, DE).
VITE_DEFAULT_COUNTRY="US"

# VITE_BASE_PATH: Vite public base path for GitHub Pages subpath hosting (e.g., "/denetflix/").
VITE_BASE_PATH="/"

# VITE_POSTHOG_KEY: Public PostHog project token for browser analytics.
VITE_POSTHOG_KEY="phc_your_project_token"

# VITE_POSTHOG_HOST: PostHog ingestion host for the selected project region.
VITE_POSTHOG_HOST="https://your-posthog-host"

# POSTHOG_API_KEY: Public PostHog project token for server-side AI Observability.
POSTHOG_API_KEY="phc_your_project_token"

# POSTHOG_HOST: PostHog ingestion host for server-side AI Observability.
POSTHOG_HOST="https://your-posthog-host"
